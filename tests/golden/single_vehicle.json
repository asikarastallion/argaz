{
  "artefacts": {
    "capability_keys": [
      "autopilot",
      "quadplane",
      "tailsitter",
      "fw_takeoff_allowed",
      "arm_vtol_only"
    ],
    "condition_keys": [
      "armed",
      "mode",
      "mode_in",
      "alt_above",
      "alt_below",
      "climb_rate_above",
      "climb_rate_below",
      "groundspeed_above",
      "prearm_ok",
      "param",
      "attitude_stable"
    ],
    "procedure_roles": [
      "takeoff",
      "land"
    ],
    "result_schema": 2,
    "run_id_pattern": "^\\d{8}T\\d{6}Z_.+",
    "statuses": [
      "passed",
      "failed",
      "error",
      "no-procedure"
    ],
    "step_types": [
      "set_param",
      "get_param",
      "set_mode",
      "arm",
      "disarm",
      "rc_override",
      "rc_release",
      "send_command",
      "upload_mission",
      "wait_for",
      "sleep"
    ]
  },
  "launch_headless": {
    "alti_transition_quad": [
      "source <QUADPLANE_ENV>",
      "gz sim -v4 -r -s alti_transition_runway.sdf &",
      "sleep 6",
      "mkdir -p <RUN_DIR>/alti_transition_quad",
      "cd <RUN_DIR>/alti_transition_quad",
      "sim_vehicle.py -v ArduPlane --model JSON --add-param-file=$SITL_MODELS/Gazebo/config/alti_transition_quad.param --out 127.0.0.1:<SCRIPT_PORT>"
    ],
    "bicopter": [
      "source <QUADPLANE_ENV>",
      "gz sim -v4 -r -s bicopter_runway.sdf &",
      "sleep 6",
      "mkdir -p <RUN_DIR>/bicopter",
      "cd <RUN_DIR>/bicopter",
      "sim_vehicle.py -v ArduCopter --model JSON --add-param-file=$SITL_MODELS/Gazebo/config/bicopter.param --out 127.0.0.1:<SCRIPT_PORT>"
    ],
    "hexapod_copter": [
      "source <QUADPLANE_ENV>",
      "gz sim -v4 -r -s hexapod_copter_runway.sdf &",
      "sleep 6",
      "mkdir -p <RUN_DIR>/hexapod_copter/scripts",
      "cp -f <SITL_MODELS>/Gazebo/scripts/hexapod_copter.lua <RUN_DIR>/hexapod_copter/scripts/",
      "cd <RUN_DIR>/hexapod_copter",
      "sim_vehicle.py -v ArduCopter -f hexa --model JSON --add-param-file=$SITL_MODELS/Gazebo/config/hexapod_copter.param --out 127.0.0.1:<SCRIPT_PORT>"
    ],
    "iris": [
      "source <ENV_SH>",
      "ros2 launch ardupilot_gz_bringup iris_runway.launch.py console:=True map:=True rviz:=True"
    ],
    "mini_talon_vtail": [
      "source <QUADPLANE_ENV>",
