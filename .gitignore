# ---------------------------------------------------------------- vendor trees
# These are separate upstream projects cloned alongside ArgazUI (>10 GB total).
# They are NOT part of this repository — see README for how to obtain them.
/ardupilot/
/ardu_ws/
/SITL_Models/
/Micro-XRCE-DDS-Gen/
/terrain/

# ------------------------------------------------------------ runtime artefacts
# Per-model SITL working directories (eeprom, logs, terrain, generated params)
/argazui/run/

# Flight run archives: runs/<UTC-time>_<model_id>/. These are the OUTPUT of
# using ArgazUI (dataflash logs, parameter dumps, reports) — they belong to
# the flight, not to the source tree. CI uploads them as build artefacts
# instead of committing them.
#
# EXCEPT the regression baselines (v1.7). A baseline is the run a later flight
# is measured against, so it is an INPUT to CI rather than an output of it, and
# a gate whose reference lived only in a 30-day build artefact would have
# nothing to compare against on day 31.
#
# Written as "exclude the contents, re-include four names" rather than
# "exclude runs/, re-include baselines/": git does not descend into an excluded
# DIRECTORY, so a negation inside one is never reached. The dataflash logs and
# plots stay out because the re-inclusions are this narrow, not by accident.
# See runs/baselines/README.md.
/runs/*
!/runs/baselines/
/runs/baselines/*
!/runs/baselines/README.md
!/runs/baselines/*/
/runs/baselines/*/*
!/runs/baselines/*/result.json
!/runs/baselines/*/fingerprint.json
!/runs/baselines/*/versions.txt
!/runs/baselines/*/scenario.yaml

# Suite records collected per tier, the way `status.yml` lays them out when it
# downloads each workflow's artefact before regenerating docs/status.md. The
# same shape is used to regenerate locally; the generated documents are
# committed, the inputs they were generated from are not.
/artefacts/

# SITL leftovers in the argaz root from manual sessions
/eeprom.bin
/mav.parm
/mav.tlog*
/last_*.txt
/*_test*.txt
/quadplane_*test*.txt

# ------------------------------------------------------------- model imagery
# Fetched from the upstream ArduPilot docs; regenerate with:
#   python3 -m argazui.fetch_images
/argazui/static/models/

# ------------------------------------------------------------------- editors
__pycache__/
*.py[cod]
.vscode/
.idea/
*.swp
.DS_Store

# SITL dataflash logs written into the argaz root by manual sessions
/logs/

# Virtual environment start.sh offers to create when no interpreter has the
# required packages (see argazui/start.sh).
/venv*/
