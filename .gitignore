# ---------------------------------------------------------------- vendor trees
# These are separate upstream projects cloned alongside ArgazUI (>10 GB total).
# They are NOT part of this repository — see README for how to obtain them.
/ardupilot/
/ardu_ws/
/SITL_Models/
/Micro-XRCE-DDS-Gen/
/terrain/

# ------------------------------------------------------------ runtime artefacts
# Per-model SITL working directories (eeprom, logs, terrain, generated params)
/argazui/run/

# Flight run archives: runs/<UTC-time>_<model_id>/. These are the OUTPUT of
# using ArgazUI (dataflash logs, parameter dumps, reports) — they belong to
# the flight, not to the source tree. CI uploads them as build artefacts
# instead of committing them.
/runs/

# SITL leftovers in the argaz root from manual sessions
/eeprom.bin
/mav.parm
/mav.tlog*
/last_*.txt
/*_test*.txt
/quadplane_*test*.txt

# ------------------------------------------------------------- model imagery
# Fetched from the upstream ArduPilot docs; regenerate with:
#   python3 -m argazui.fetch_images
/argazui/static/models/

# ------------------------------------------------------------------- editors
__pycache__/
*.py[cod]
.vscode/
.idea/
*.swp
.DS_Store

# SITL dataflash logs written into the argaz root by manual sessions
/logs/

# Virtual environment start.sh offers to create when no interpreter has the
# required packages (see argazui/start.sh).
/venv*/
